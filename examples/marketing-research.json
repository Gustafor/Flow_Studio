      "roles": "Стратег",
      "tools": [
        "read"
      ],
      "after": [
        "s1"
      ]
    },
    "g1": {
      "id": "g1",
      "type": "exclusive",
      "name": "Бюджет?",
      "systemPrompt": "",
      "inputTemplate": "",
      "roles": "",
      "tools": [],
