        {
          "id": "b1",
          "target": "s3a",
          "condition": "Бюджет на запуск есть (>= 50 000)",
          "isDefault": false
        },
        {
          "id": "b2",
          "target": "s3b",
          "condition": "Бюджет ограничен / нет",
          "isDefault": false
        },
        {
          "id": "b3",
          "target": "s4",
          "condition": "",
          "isDefault": true
        }
      ],
      "after": [
        "s2"
      ]
    },
    "s3a": {
      "id": "s3a",
      "type": "agent",
      "name": "План запуска (полный)",
      "systemPrompt": "Составь 30-дневный план запуска с бюджетами по каналам и KPI.",
      "inputTemplate": "SWOT: {{Анализ и SWOT}}\nБюджет: достаточный.",
      "roles": "",
      "tools": [
        "read",
        "write"
      ],
      "after": []
