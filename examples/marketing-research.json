    "s3b": {
      "id": "s3b",
      "type": "agent",
      "name": "План запуска (минимальный)",
      "systemPrompt": "Составь план запуска на 10 000: 1 канал, 1 оффер, 1 метрика успеха.",
      "inputTemplate": "SWOT: {{Анализ и SWOT}}\nБюджет: минимальный (10 000).",
      "roles": "",
      "tools": [
        "read",
        "write"
      ],
      "after": []
    },
    "s4": {
      "id": "s4",
      "type": "output",
      "name": "Отчёт",
      "systemPrompt": "",
      "inputTemplate": "",
      "roles": "",
